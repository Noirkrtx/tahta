{
  "name": "tahta",
  "version": "0.1.0",
  "private": true,
  "description": "Ask a question, watch the answer get written and drawn on a board, step by step.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "tsc --noEmit && node scripts/build-artifact.mjs",
    "preview": "node scripts/onizle.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
